# ==== Обязательные ====

# Токен бота — получить у @BotFather
BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# api_id / api_hash — получить на https://my.telegram.org (раздел API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Telegram user_id тех, кому разрешено пользоваться ботом (через запятую).
# Свой ID можно узнать у @userinfobot. Пустое значение = доступ закрыт для всех.
ADMIN_IDS=123456789

# ==== Опциональные (значения по умолчанию) ====
# DB_PATH=data/bot.db

# Пауза между реакциями на сообщения, секунды
# REACTION_DELAY_MIN=0.8
# REACTION_DELAY_MAX=1.6

# Пауза между лайками историй, секунды
# STORY_REACTION_DELAY_MIN=0.6
# STORY_REACTION_DELAY_MAX=1.2

# Пауза между опросом участников (стории), секунды
# PEER_DELAY_MIN=0.3
# PEER_DELAY_MAX=0.8

# Значения по умолчанию для лимитов (в боте можно выбрать свои — включая ♾ без лимита)
# DEFAULT_MESSAGES_LIMIT=1000
# DEFAULT_PEERS_LIMIT=300

# Пауза между отправками сообщений (рассылка), секунды
# SEND_DELAY_MIN=3.0
# SEND_DELAY_MAX=7.0

# Максимальная пауза при FloodWait, секунды (если Telegram просит дольше — задача остановится)
# FLOOD_WAIT_CAP=300

# Интервал обновления сообщения-прогресса, секунды
# PROGRESS_INTERVAL=8

# Сколько задач пользователя выполняются ОДНОВРЕМЕННО (остальные ждут в очереди)
# MAX_CONCURRENT_TASKS=5
